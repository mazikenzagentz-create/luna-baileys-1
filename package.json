{
  "name": "@nerxa/socketon",
  "version": "1.21.0",
  "description": "Nerxa socket / modded Baileys — interactive message, album, messageBuilder, newsletter, VoIP",
  "repository": {
    "type": "git",
    "url": "https://github.com/mazikenzagentz-create/luna-baileys-1.git"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "type": "module",
  "scripts": {
    "preinstall": "node ./engine-requirements.js",
    "test": "node --test \"test/*.test.js\"",
    "update:version": "node ./script/updatewa.js",
    "check:proto": "node ./script/checkproto.js",
    "sync:proto": "node ./script/syncproto.js",
    "build:docs": "node ./script/apiref.js site-api.json && node ./script/builddocs.js site",
    "wa:update": "node ./script/waupdate.js",
    "wa:diff": "node ./script/diffbundle.js",
    "audit:apk": "node ./script/auditapk.js",
    "verify:proto": "node ./script/verifyproto.js",
    "verify:mex": "node ./script/verifymex.js",
    "verify:assets": "node ./script/verifyassets.js",
    "fetch:bundle": "node ./script/fetchbundle.js",
    "test:pairing": "node ./script/testpairing.js",
    "proto:update": "npm run sync:proto && npm run verify:proto && npm run verify:mex && npm run wa:update -- --apply --keep 2 && npm run update:version"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "src/**/*",
    "WAProto/**/*",
    "engine-requirements.js",
    "EXPERIMENTAL.md",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "nerxa",
    "socketon",
    "baileys",
    "whatsapp",
    "whatsapp-api",
    "whatsapp-bot",
    "multi-device",
    "bot",
    "automation"
  ],
  "author": "nerxa",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@adiwajshing/keyed-db": "^0.2.4",
    "@hapi/boom": "^9.1.3",
    "@rexxhayanasi/wangcap-id-bridge": "^1.0.0",
    "async-mutex": "^0.5.0",
    "fflate": "^0.8.2",
    "libsignal": "^6.0.0",
    "lru-cache": "^11.2.6",
    "music-metadata": "^11.12.3",
    "p-queue": "^9.1.0",
    "pino": "^9.6.0",
    "protobufjs": "^7.5.6",
    "ws": "^8.19.0"
  },
  "optionalDependencies": {
    "@rexxhayanasi/elaina-anchorguard": "^1.0.0"
  },
  "peerDependencies": {
    "@napi-rs/image": "~1.12.0",
    "@nekodb/client": "*",
    "audio-decode": "^2.2.3",
    "better-sqlite3": "^11.0.0 || ^12.0.0 || ^13.0.0",
    "fluent-ffmpeg": "*",
    "ioredis": "^5.0.0",
    "jimp": "^1.6.1",
    "link-preview-js": "^3.0.0",
    "mongodb": "^6.0.0",
    "mysql2": "^3.0.0",
    "pg": "^8.0.0",
    "sharp": "^0.35.0"
  },
  "peerDependenciesMeta": {
    "@napi-rs/image": { "optional": true },
    "@nekodb/client": { "optional": true },
    "audio-decode": { "optional": true },
    "better-sqlite3": { "optional": true },
    "fluent-ffmpeg": { "optional": true },
    "ioredis": { "optional": true },
    "jimp": { "optional": true },
    "link-preview-js": { "optional": true },
    "mongodb": { "optional": true },
    "mysql2": { "optional": true },
    "pg": { "optional": true },
    "sharp": { "optional": true }
  }
}
